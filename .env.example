# Copiar a .env (no versionado) y ajustar valores. Nunca subir secretos al repositorio.

# --- Aplicación ---
APP_ENV=development
APP_TIMEZONE=America/Bogota
PORT=8080
LOG_LEVEL=info

# --- Base de datos (E1: contenedor | E2+: Cloud SQL, solo cambia DATABASE_URL) ---
POSTGRES_DB=seguimiento
POSTGRES_USER=seguimiento
POSTGRES_PASSWORD=cambiar-en-local
DATABASE_URL=postgres://seguimiento:cambiar-en-local@db:5432/seguimiento?sslmode=disable
DB_AUTO_MIGRATE=true

# --- Autenticación ---
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo
JWT_TTL=8h
# Costo de bcrypt (4-31). Mayor costo = más seguro y más CPU por inicio de sesión.
BCRYPT_COST=10
BOOTSTRAP_ADMIN_NAME=Administrador del sistema
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=cambiar-en-local

# --- Cola de trabajos (E1-E3: asynq | E4: pubsub) ---
QUEUE_DRIVER=asynq
REDIS_ADDR=redis:6379
WORKER_CONCURRENCY=4

# --- Almacenamiento de archivos (E1: local | E2+: gcs) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/app/files
GCS_BUCKET=
MAX_UPLOAD_MB=20

# --- IA generativa (fake | claude) ---
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
