    {
      "name": "6. Cierre de sesión",
      "description": "Va al final porque invalida los tokens de la monitora y del profesor.",
      "item": [
        {
          "name": "Monitora cierra sesión en este dispositivo → 204",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
