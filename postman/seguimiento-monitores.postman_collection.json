{
  "info": {
    "name": "Seguimiento de monitores · API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de la API.\n\n**Uso**\n1. Importa esta colección y el entorno `local.postman_environment.json` (o la plantilla `example.postman_environment.json`, completando correos y contraseñas).\n2. Selecciona el entorno **Seguimiento · local**.\n3. Ejecuta las carpetas en orden (o *Run collection*): los inicios de sesión guardan los tokens en `admin_token`, `profesor_token` y `monitora_token`.\n\nEl contrato completo está en `docs/api/openapi.yaml`, que Postman también puede importar."
  },
  "item": [
    {
      "name": "1. Salud",
      "description": "",
      "item": [
        {
          "name": "Health check (/healthz)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "2. Autenticación",
      "description": "",
      "item": [
        {
          "name": "Iniciar sesión · administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Abre una sesión como administrador y guarda el token en `admin_token` y el ID en `admin_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"admin_token\", body.access_token);",
                  "pm.environment.set(\"admin_id\", body.user.id);",
                  "pm.test(\"entrega un token Bearer\", () => pm.expect(body.token_type).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión · profesor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Abre una sesión como profesor y guarda el token en `profesor_token` y el ID en `profesor_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{profesor_email}}\",\n  \"password\": \"{{profesor_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"profesor_token\", body.access_token);",
                  "pm.environment.set(\"profesor_id\", body.user.id);",
                  "pm.test(\"entrega un token Bearer\", () => pm.expect(body.token_type).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión · monitora (2 roles)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Abre una sesión como monitora (2 roles) y guarda el token en `monitora_token` y el ID en `monitora_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{monitora_email}}\",\n  \"password\": \"{{monitora_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"monitora_token\", body.access_token);",
                  "pm.environment.set(\"monitora_id\", body.user.id);",
                  "pm.test(\"entrega un token Bearer\", () => pm.expect(body.token_type).to.eql(\"Bearer\"));",
                  "pm.test(\"tiene dos roles\", () => pm.expect(body.user.roles).to.have.members([\"ASISTENTE_GRADUADO\", \"MONITOR\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil · monitora (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Datos y roles vigentes del usuario autenticado.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{monitora_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"devuelve sus roles\", () => pm.expect(pm.response.json().roles).to.have.lengthOf(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Usuarios (ADMIN)",
      "description": "",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users"
              ]
            },
            "description": "Crea un usuario con correo único por ejecución y guarda su ID en `created_user_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Usuario de Postman\",\n  \"email\": \"postman.{{$timestamp}}@example.com\",\n  \"password\": \"Postman-{{$timestamp}}\",\n  \"roles\": [\n    \"PROFESOR\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"created_user_id\", pm.response.json().id);",
                  "pm.test(\"no expone la contraseña\", () => pm.expect(pm.response.text()).not.to.include(\"password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?limit=50&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"incluye el total\", () => pm.expect(pm.response.json().total).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar por rol (MONITOR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?role=MONITOR",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "MONITOR"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"todos tienen el rol MONITOR\", () => pm.response.json().items.forEach(u => pm.expect(u.roles).to.include(\"MONITOR\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar usuario creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{created_user_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users",
                "{{created_user_id}}"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reemplazar roles del usuario creado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users/{{created_user_id}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "users",
                "{{created_user_id}}",
                "roles"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    \"PROFESOR\",\n    \"MONITOR\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"roles reemplazados\", () => pm.expect(pm.response.json().roles).to.eql([\"MONITOR\", \"PROFESOR\"]));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{admin_token}}",
            "type": "string"
          }
        ]
      }
    },
